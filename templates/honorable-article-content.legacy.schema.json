{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compulsive-research.local/honorable-article-content.schema.json",
  "title": "Compulsive Research categorized Honorable Mention content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "cardName",
    "category",
    "navigationScope",
    "landingReturnHref",
    "categoryDescription",
    "searchTerms",
    "cardTypes",
    "landingAnchor",
    "articleTitle",
    "deckline",
    "release",
    "readingTimeMinutes",
    "hero",
    "sections",
    "designEcho",
    "decklists",
    "originalSetCode",
    "printings",
    "sources",
    "navigation",
    "preconstructedDeckArchive",
    "cardImageStandard"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^honorable-(?![0-9]{3}-)[a-z0-9-]+\\.html$",
      "description": "Stable, unnumbered article filename. Never encode category order in the filename."
    },
    "cardName": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Exact category label from data/honorable-categories.json."
    },
    "landingAnchor": {
      "type": "string",
      "pattern": "^honorable-[a-z0-9-]+$",
      "description": "Stable landing-page focus anchor derived from the unnumbered filename."
    },
    "articleTitle": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "description": "Unique thematic essay title. It must be relevant to the card, contain no full card name, and duplicate no other archive headline."
    },
    "deckline": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "year"
      ],
      "properties": {
        "set": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1993,
          "maximum": 2100
        }
      }
    },
    "readingTimeMinutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 40
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardName",
        "scryfallId",
        "artUrl",
        "position"
      ],
      "properties": {
        "cardName": {
          "type": "string",
          "minLength": 1
        },
        "scryfallId": {
          "type": "string",
          "minLength": 1
        },
        "artUrl": {
          "type": "string",
          "format": "uri"
        },
        "position": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapter",
          "title",
          "bodyHtml"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "chapter": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "bodyHtml": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "designEcho": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "cardName"
      ],
      "properties": {
        "cardName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decklists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "deckName",
          "mainDeck",
          "sideboard",
          "provenance"
        ],
        "properties": {
          "deckName": {
            "type": "string",
            "minLength": 1
          },
          "mainDeck": {
            "type": "array",
            "minItems": 1
          },
          "sideboard": {
            "type": "array"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "historical-registration",
              "community-documented",
              "editorial-study-shell"
            ]
          }
        }
      }
    },
    "originalSetCode": {
      "type": "string",
      "minLength": 1
    },
    "printings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "cardName",
          "scryfallId",
          "setCode",
          "caption",
          "imageUrl"
        ],
        "properties": {
          "cardName": {
            "type": "string",
            "minLength": 1
          },
          "scryfallId": {
            "type": "string",
            "minLength": 1
          },
          "setCode": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "previous",
        "next"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "previous": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cardName",
                "slug"
              ],
              "properties": {
                "cardName": {
                  "type": "string",
                  "minLength": 1
                },
                "slug": {
                  "type": "string",
                  "pattern": "^honorable-(?![0-9]{3}-)[a-z0-9-]+\\.html$"
                }
              }
            }
          ]
        },
        "next": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cardName",
                "slug"
              ],
              "properties": {
                "cardName": {
                  "type": "string",
                  "minLength": 1
                },
                "slug": {
                  "type": "string",
                  "pattern": "^honorable-(?![0-9]{3}-)[a-z0-9-]+\\.html$"
                }
              }
            }
          ]
        }
      },
      "description": "Previous and next must be immediate neighbors in the same category landing-page order. The first and last article use null at the open end; no global ordinal is stored."
    },
    "cardTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "creature",
          "artifact",
          "enchantment",
          "instant",
          "sorcery",
          "land",
          "planeswalker",
          "battle",
          "kindred"
        ]
      }
    },
    "searchTerms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "categoryDescription": {
      "type": "string",
      "minLength": 1
    },
    "landingReturnHref": {
      "type": "string",
      "pattern": "^index\\.html\\?focus=honorable-[a-z0-9-]+#honorable-[a-z0-9-]+$"
    },
    "navigationScope": {
      "const": "category-local",
      "description": "Honorable Mention articles never navigate outside their assigned category."
    },
    "preconstructedDeckArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "catalogueSnapshot",
        "sectionLabel",
        "includeAllMatches",
        "allowNoSideboard",
        "collapsedByDefault",
        "productDecksCollapsedByDefault",
        "emptyState"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "mode": {
          "const": "static-embedded",
          "description": "Decklists are compiled into article HTML at build time. Browser-side catalogue fetching is forbidden."
        },
        "catalogueSnapshot": {
          "type": "string",
          "pattern": "^data/official-mtg-deck-catalogue\\.json$"
        },
        "sectionLabel": {
          "const": "Official Magic the Gathering decks"
        },
        "includeAllMatches": {
          "const": true,
          "description": "Embed every qualifying official deck product containing the article card."
        },
        "allowNoSideboard": {
          "const": true,
          "description": "Products without sideboards remain without sideboards."
        },
        "collapsedByDefault": {
          "const": true
        },
        "productDecksCollapsedByDefault": {
          "const": true
        },
        "emptyState": {
          "const": "No official Magic the Gathering products contained this particular card."
        }
      },
      "description": "Static, offline official-product deck archive generated from the committed catalogue snapshot. Counts and contents are derived from integer card rows."
    },
    "cardImageStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deckRowsLinked",
        "doubleFacedPolicy",
        "leadFaceRules",
        "emptyOfficialDeckCountLabel"
      ],
      "properties": {
        "deckRowsLinked": {
          "const": true,
          "description": "Every rendered quantity row wraps the exact card name in canonical .card-name markup."
        },
        "doubleFacedPolicy": {
          "const": "scryfall-card-faces",
          "description": "Use Scryfall card_faces image_uris so physical front and back faces are distinct."
        },
        "leadFaceRules": {
          "const": "one-panel-per-physical-face",
          "description": "A physical double-faced namesake displays both face images and a separate rules panel for each face."
        },
        "emptyOfficialDeckCountLabel": {
          "const": "0",
          "description": "A zero-result Official Magic the Gathering decks summary displays the numeral 0."
        }
      }
    }
  }
}
