{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compulsive-research.local/honorable-article-content.schema-v2.json",
  "title": "Compulsive Research categorized Honorable Mention content — Editorial V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "articleClass",
    "thesis",
    "classicPlayVignette",
    "canonicalIdentity",
    "originalContext",
    "loreContext",
    "competitiveTimeline",
    "playbook",
    "counterplay",
    "claims",
    "mechanicalStatus",
    "editorialStatus",
    "researchStatus",
    "releaseStatus",
    "lastHistoricallyReviewed",
    "currentInformationAsOf",
    "slug",
    "cardName",
    "category",
    "navigationScope",
    "landingReturnHref",
    "categoryDescription",
    "searchTerms",
    "cardTypes",
    "landingAnchor",
    "articleTitle",
    "deckline",
    "release",
    "readingTimeMinutes",
    "readingWordCount",
    "hero",
    "sections",
    "designEcho",
    "decklists",
    "originalSetCode",
    "printings",
    "sources",
    "navigation",
    "preconstructedDeckArchive",
    "cardImageStandard"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "articleClass": {
      "type": "string",
      "enum": [
        "tournament-pillar",
        "character-or-story-object",
        "combo-or-engine-piece",
        "design-landmark",
        "casual-icon",
        "banned-or-restricted-card",
        "collector-object"
      ]
    },
    "secondaryClasses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "tournament-pillar",
          "character-or-story-object",
          "combo-or-engine-piece",
          "design-landmark",
          "casual-icon",
          "banned-or-restricted-card",
          "collector-object"
        ]
      }
    },
    "thesis": {
      "type": "string",
      "minLength": 80,
      "description": "Card-specific claim explaining why this card belongs in the archive."
    },
    "strategicLegacy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reader-facing synthesis rendered immediately after the opening card introduction, never before it.",
      "required": [
        "heading",
        "lead",
        "use",
        "counterplay",
        "record"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "use": {
          "type": "string",
          "minLength": 1
        },
        "counterplay": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "recordLabel": {
          "type": "string",
          "enum": [
            "Tournament record",
            "Cultural record",
            "Tournament and cultural record"
          ]
        }
      }
    },
    "canonicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracleId",
        "oracleName",
        "firstPrintingSetCode",
        "firstPrintingSetName",
        "releaseDate",
        "scryfallId",
        "illustrationId",
        "originalArtist",
        "currentOracleText",
        "promotionalDebut"
      ],
      "properties": {
        "oracleId": {
          "type": "string",
          "minLength": 1
        },
        "oracleName": {
          "type": "string",
          "minLength": 1
        },
        "firstPrintingSetCode": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "firstPrintingSetName": {
          "type": "string",
          "minLength": 1
        },
        "releaseDate": {
          "type": "string",
          "format": "date"
        },
        "scryfallId": {
          "type": "string",
          "minLength": 1
        },
        "illustrationId": {
          "type": "string"
        },
        "originalArtist": {
          "type": "string",
          "minLength": 1
        },
        "originalPrintedText": {
          "type": "string"
        },
        "currentOracleText": {
          "type": "string"
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "oracleText": {
                "type": "string"
              },
              "scryfallId": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "promotionalDebut": {
          "type": "boolean"
        },
        "identityNotes": {
          "type": "string"
        }
      }
    },
    "originalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setEnvironment",
        "designPurpose",
        "initialReception"
      ],
      "properties": {
        "setEnvironment": {
          "type": "string",
          "minLength": 1
        },
        "designPurpose": {
          "type": "string",
          "minLength": 1
        },
        "initialReception": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "loreContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "summary",
        "sourceIds"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "full",
            "flavor-only",
            "none-documented"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "depictedMoment": {
          "type": "string"
        },
        "relatedStoryCards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "competitiveTimeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "significance",
          "sourceIds"
        ],
        "properties": {
          "date": {
            "type": "string",
            "minLength": 4
          },
          "format": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "player": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "archetype": {
            "type": "string"
          },
          "significance": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "deckRequirements",
        "copyCount",
        "mulligans",
        "sequencing",
        "sideboarding",
        "commonMistakes"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "deckRequirements": {
          "type": "string",
          "minLength": 1
        },
        "copyCount": {
          "type": "string",
          "minLength": 1
        },
        "mulligans": {
          "type": "string",
          "minLength": 1
        },
        "sequencing": {
          "type": "string",
          "minLength": 1
        },
        "sideboarding": {
          "type": "string",
          "minLength": 1
        },
        "commonMistakes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counterplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directAnswers",
        "engineDisruption",
        "timingWindows",
        "racing",
        "sideboarding"
      ],
      "properties": {
        "directAnswers": {
          "type": "string",
          "minLength": 1
        },
        "engineDisruption": {
          "type": "string",
          "minLength": 1
        },
        "timingWindows": {
          "type": "string",
          "minLength": 1
        },
        "racing": {
          "type": "string",
          "minLength": 1
        },
        "sideboarding": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "summary",
          "sourceIds",
          "confidence"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "disputed"
            ]
          },
          "asOf": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "mechanicalStatus": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "fail"
      ]
    },
    "editorialStatus": {
      "type": "string",
      "enum": [
        "benchmark",
        "reviewed",
        "audit-required",
        "rewrite-required"
      ]
    },
    "researchStatus": {
      "type": "string",
      "enum": [
        "scaffold",
        "in-research",
        "draft",
        "fact-checked",
        "complete"
      ]
    },
    "releaseStatus": {
      "type": "string",
      "enum": [
        "draft",
        "staging",
        "production"
      ]
    },
    "lastHistoricallyReviewed": {
      "type": "string",
      "format": "date"
    },
    "currentInformationAsOf": {
      "type": "string",
      "format": "date"
    },
    "reviewNotes": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^honorable-(?![0-9]{3}-)[a-z0-9-]+\\.html$",
      "description": "Stable, unnumbered article filename. Never encode category order in the filename."
    },
    "cardName": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Exact category label from data/honorable-categories.json."
    },
    "landingAnchor": {
      "type": "string",
      "pattern": "^honorable-[a-z0-9-]+$",
      "description": "Stable landing-page focus anchor derived from the unnumbered filename."
    },
    "articleTitle": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "description": "Unique thematic essay title. It must be relevant to the card, contain no full card name, and duplicate no other archive headline."
    },
    "deckline": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "year"
      ],
      "properties": {
        "set": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1993,
          "maximum": 2100
        }
      }
    },
    "readingTimeMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "description": "Derived, never hand-entered: ceiling of readingWordCount / 200."
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardName",
        "scryfallId",
        "artUrl",
        "position"
      ],
      "properties": {
        "cardName": {
          "type": "string",
          "minLength": 1
        },
        "scryfallId": {
          "type": "string",
          "minLength": 1
        },
        "artUrl": {
          "type": "string",
          "format": "uri"
        },
        "position": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapter",
          "title",
          "bodyHtml"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "chapter": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "bodyHtml": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "designEcho": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "cardName"
      ],
      "properties": {
        "cardName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decklists": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "deckName",
          "mainDeck",
          "sideboard",
          "provenance"
        ],
        "properties": {
          "deckName": {
            "type": "string",
            "minLength": 1
          },
          "mainDeck": {
            "type": "array",
            "minItems": 1
          },
          "sideboard": {
            "type": "array"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "tournament-registration",
              "official-digital-deck",
              "curated-example"
            ],
            "description": "Production deck provenance. Synthetic editorial study shells are forbidden."
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "reviewedBy": {
            "type": "string",
            "minLength": 1
          },
          "legalityAsOf": {
            "type": "string",
            "format": "date"
          },
          "formatLegalityNote": {
            "type": "string"
          }
        },
        "description": "Documentary registrations, official digital records, or reviewed curated examples. An empty array is valid when no reliable list is available."
      }
    },
    "originalSetCode": {
      "type": "string",
      "minLength": 1
    },
    "printings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "cardName",
          "scryfallId",
          "setCode",
          "caption",
          "imageUrl"
        ],
        "properties": {
          "cardName": {
            "type": "string",
            "minLength": 1
          },
          "scryfallId": {
            "type": "string",
            "minLength": 1
          },
          "setCode": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "previous",
        "next"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "previous": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cardName",
                "slug"
              ],
              "properties": {
                "cardName": {
                  "type": "string",
                  "minLength": 1
                },
                "slug": {
                  "type": "string",
                  "pattern": "^honorable-(?![0-9]{3}-)[a-z0-9-]+\\.html$"
                }
              }
            }
          ]
        },
        "next": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cardName",
                "slug"
              ],
              "properties": {
                "cardName": {
                  "type": "string",
                  "minLength": 1
                },
                "slug": {
                  "type": "string",
                  "pattern": "^honorable-(?![0-9]{3}-)[a-z0-9-]+\\.html$"
                }
              }
            }
          ]
        }
      },
      "description": "Previous and next must be immediate neighbors in the same category landing-page order. The first and last article use null at the open end; no global ordinal is stored."
    },
    "cardTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "creature",
          "artifact",
          "enchantment",
          "instant",
          "sorcery",
          "land",
          "planeswalker",
          "battle",
          "kindred"
        ]
      }
    },
    "searchTerms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "categoryDescription": {
      "type": "string",
      "minLength": 1
    },
    "landingReturnHref": {
      "type": "string",
      "pattern": "^index\\.html\\?focus=honorable-[a-z0-9-]+#honorable-[a-z0-9-]+$"
    },
    "navigationScope": {
      "const": "category-local",
      "description": "Honorable Mention articles never navigate outside their assigned category."
    },
    "preconstructedDeckArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "catalogueSnapshot",
        "sectionLabel",
        "includeAllMatches",
        "allowNoSideboard",
        "collapsedByDefault",
        "productDecksCollapsedByDefault",
        "emptyState"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "mode": {
          "const": "static-embedded",
          "description": "Decklists are compiled into article HTML at build time. Browser-side catalogue fetching is forbidden."
        },
        "catalogueSnapshot": {
          "type": "string",
          "pattern": "^data/official-mtg-deck-catalogue\\.json$"
        },
        "sectionLabel": {
          "const": "Official Magic the Gathering decks"
        },
        "includeAllMatches": {
          "const": true,
          "description": "Embed every qualifying official deck product containing the article card."
        },
        "allowNoSideboard": {
          "const": true,
          "description": "Products without sideboards remain without sideboards."
        },
        "collapsedByDefault": {
          "const": true
        },
        "productDecksCollapsedByDefault": {
          "const": true
        },
        "emptyState": {
          "const": "No official Magic the Gathering products contained this particular card."
        }
      },
      "description": "Static, offline official-product deck archive generated from the committed catalogue snapshot. Counts and contents are derived from integer card rows."
    },
    "cardImageStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deckRowsLinked",
        "doubleFacedPolicy",
        "leadFaceRules",
        "emptyOfficialDeckCountLabel"
      ],
      "properties": {
        "deckRowsLinked": {
          "const": true,
          "description": "Every rendered quantity row wraps the exact card name in canonical .card-name markup."
        },
        "doubleFacedPolicy": {
          "const": "scryfall-card-faces",
          "description": "Use Scryfall card_faces image_uris so physical front and back faces are distinct."
        },
        "leadFaceRules": {
          "const": "one-panel-per-physical-face",
          "description": "A physical double-faced namesake displays both face images and a separate rules panel for each face."
        },
        "emptyOfficialDeckCountLabel": {
          "const": "0",
          "description": "A zero-result Official Magic the Gathering decks summary displays the numeral 0."
        }
      }
    },
    "classicPlayVignette": {
      "type": "object",
      "additionalProperties": false,
      "description": "A period-grounded first-person table story placed late in the opening after the card image, rules text, and original identity. The visible article uses the label A story from the table and prints only the scene; era, matchup, reconstruction status, and opening mode remain in structured metadata.",
      "required": [
        "scenarioType",
        "voice",
        "era",
        "matchup",
        "deckReference",
        "namedCards",
        "openingMode",
        "title",
        "body"
      ],
      "properties": {
        "scenarioType": {
          "type": "string",
          "const": "representative-recollection"
        },
        "era": {
          "type": "string",
          "pattern": "(^|.*\\b)(19|20)\\d{2}\\b.*",
          "description": "A dated format or tournament-era frame, such as 1994 Type I or 2005 Vintage Championship."
        },
        "matchup": {
          "type": "string",
          "minLength": 8,
          "description": "One deck against one opposing archetype; never a multiplayer table."
        },
        "deckReference": {
          "type": "string",
          "minLength": 4,
          "description": "Exact title of a documentary or clearly labeled curated deck in the article archive that contains the featured card and supports the line."
        },
        "namedCards": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 90
        },
        "body": {
          "type": "string",
          "minLength": 600,
          "maxLength": 2200,
          "description": "A 70–170 word first-person table story using I/me/my rather than second-person instruction. It depicts one opponent and exact card sequencing, but it does not need to begin with a memory cue. Openings must vary naturally across the wave and may begin with action, dialogue, a board state, a life total, a revealed hand, an opening hand, or another card-specific detail. End on the decisive play, reaction, reversal, or immediate board state without an explanatory coda."
        },
        "historicalFrame": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "const": "first-person-recollection"
        },
        "openingMode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60,
          "description": "Hidden description of the story entry point, such as opponent-action, table-dialogue, board-state, life-total, revealed-information, opening-hand, or counterintuitive-play. Rotate modes within each 50-article wave."
        }
      }
    },
    "readingWordCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Derived continuous-prose count. Excludes expandable decklists, printing galleries, source records, hidden copy buffers, scripts, and styles."
    }
  }
}
