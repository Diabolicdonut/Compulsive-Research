{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compulsive-research.local/article-content.schema.json",
  "title": "Compulsive Research numbered article content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry",
    "slug",
    "cardName",
    "wave",
    "articleTitle",
    "deckline",
    "release",
    "readingTimeMinutes",
    "hero",
    "artworkSpotlight",
    "sections",
    "designEcho",
    "decklists",
    "originalSetCode",
    "printings",
    "sources",
    "preconstructedDeckArchive",
    "cardImageStandard"
  ],
  "properties": {
    "entry": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Archive entry number; must match archive-manifest.json."
    },
    "slug": {
      "type": "string",
      "pattern": "^[0-9]{3,4}-[a-z0-9-]+\\.html$"
    },
    "cardName": {
      "type": "string",
      "minLength": 1
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "landingAnchor"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "description": "Wave number copied from archive-manifest.json."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Exact landing-page wave title copied verbatim from archive-manifest.json; never replace with an editorial lens."
        },
        "landingAnchor": {
          "type": "string",
          "pattern": "^entry-[0-9]{3,4}$",
          "description": "Exact landing anchor copied from archive-manifest.json."
        }
      }
    },
    "articleTitle": {
      "type": "string",
      "minLength": 12,
      "description": "Unique, card-relevant editorial headline. It must not duplicate any other numbered article or reuse a shared category heading."
    },
    "deckline": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "year"
      ],
      "properties": {
        "set": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1993,
          "maximum": 2100
        }
      }
    },
    "readingTimeMinutes": {
      "type": "integer",
      "minimum": 20,
      "maximum": 40
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artUrl",
        "position"
      ],
      "properties": {
        "artUrl": {
          "type": "string",
          "format": "uri"
        },
        "position": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapter",
          "title",
          "bodyHtml"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "chapter": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "bodyHtml": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decklists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deckKind",
          "player",
          "deckName",
          "event",
          "format",
          "date",
          "mainDeck",
          "sideboard",
          "source"
        ],
        "properties": {
          "deckKind": {
            "type": "string",
            "enum": [
              "tournament-registration",
              "editorial-study",
              "official-digital-deck"
            ],
            "description": "Use official-digital-deck for documented digital product/opponent lists. Official product decks are compiled statically through preconstructedDeckArchive, not invented as tournament registrations."
          },
          "player": {
            "type": "string",
            "minLength": 1
          },
          "deckName": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "placement": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 4
          },
          "mainDeck": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "count"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                "setCode": {
                  "type": "string"
                },
                "collectorNumber": {
                  "type": "string"
                },
                "foil": {
                  "type": "boolean"
                }
              }
            },
            "description": "Authoritative rows. Main-deck totals are always computed with integer addition; never supply a display total string."
          },
          "sideboard": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "count"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                "setCode": {
                  "type": "string"
                },
                "collectorNumber": {
                  "type": "string"
                },
                "foil": {
                  "type": "boolean"
                }
              }
            },
            "description": "May be empty when the historical source has no sideboard. The displayed total is derived from counts."
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "sourceSizeException": {
            "type": "string",
            "minLength": 1,
            "description": "Optional documented exception when a published tournament source explicitly records a nonstandard or incomplete sideboard. Never use this to coerce or conceal a counting error."
          },
          "sourceResolution": {
            "type": "string",
            "minLength": 1,
            "description": "Optional note identifying how conflicting or incomplete historical transcriptions were resolved."
          }
        },
        "description": "Documentary tournament registrations, official digital deck records, or clearly labeled editorial studies. Every group, main-deck, sideboard, metadata, prose, data attribute, and copy-text total is derived from integer row quantities. Published anomalies require sourceSizeException/sourceResolution rather than invented cards."
      }
    },
    "printings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cardName",
          "oracleId",
          "scryfallId",
          "illustrationId",
          "setCode",
          "collectorNumber",
          "caption",
          "imageUrl"
        ],
        "properties": {
          "cardName": {
            "type": "string",
            "minLength": 1,
            "description": "Must exactly equal the article subject card name."
          },
          "oracleId": {
            "type": "string",
            "minLength": 1,
            "description": "All gallery records must share this exact Scryfall Oracle ID."
          },
          "scryfallId": {
            "type": "string",
            "minLength": 1,
            "description": "Unique Scryfall printing ID; duplicates are forbidden."
          },
          "illustrationId": {
            "type": "string",
            "description": "Used to prioritize different artworks before same-art reprints."
          },
          "setCode": {
            "type": "string",
            "minLength": 1
          },
          "collectorNumber": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "description": "One to twelve verified English paper printings rendered before Sources. Every record must have the exact article card name and the same Oracle ID. Choose distinct illustration IDs first, then fill remaining slots with other legitimate printings. If fewer than twelve printings exist, include all of them.",
      "maxItems": 12
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "note"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Source records rendered as <ol class=\"sources\"> immediately after the exact <h3>Sources</h3> heading, which must immediately follow the printing gallery."
    },
    "artworkSpotlight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artist",
        "setName",
        "setCode",
        "imageUrl",
        "fallbackUrl",
        "position",
        "excerpt",
        "afterSectionId"
      ],
      "properties": {
        "artist": {
          "type": "string",
          "minLength": 2,
          "description": "Required static artist credit verified against the exact original printing shown. Do not leave blank or depend on runtime lookup."
        },
        "setName": {
          "type": "string",
          "minLength": 1,
          "description": "Exact display name of the original set represented by the artwork."
        },
        "setCode": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "Original-printing art_crop image."
        },
        "fallbackUrl": {
          "type": "string",
          "format": "uri",
          "description": "Normal card image used only if the art crop fails."
        },
        "position": {
          "type": "string",
          "const": "center 25%",
          "description": "Locked to the Eternal Dragon crop convention."
        },
        "excerpt": {
          "type": "string",
          "minLength": 55,
          "description": "One or two card-specific sentences about the visible artwork itself. Identify a subject, object, action, or setting and discuss at least one visual quality such as composition, framing, palette, light, shadow, gesture, motion, texture, scale, or atmosphere. Do not discuss strategy, tournament history, rules function, publication logistics, Scryfall/catalog display, the article, or the artwork merely establishing a strategic/visual identity."
        },
        "afterSectionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Place the spotlight after the second substantive article section, matching Eternal Dragon."
        }
      }
    },
    "designEcho": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapter",
        "heading",
        "introHtml",
        "cardName",
        "setLabel",
        "panelTitle",
        "panelHtml",
        "closingHtml",
        "apiUrl",
        "fallbackArtUrl",
        "fallbackNormalUrl",
        "fallbackFuzzyUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "chapter": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "introHtml": {
          "type": "string",
          "minLength": 1
        },
        "cardName": {
          "type": "string",
          "minLength": 1
        },
        "setLabel": {
          "type": "string",
          "minLength": 1
        },
        "panelTitle": {
          "type": "string",
          "minLength": 1
        },
        "panelHtml": {
          "type": "string",
          "minLength": 1
        },
        "closingHtml": {
          "type": "string",
          "minLength": 1
        },
        "fallbackNormalUrl": {
          "type": "string",
          "format": "uri"
        },
        "fallbackFuzzyUrl": {
          "type": "string",
          "format": "uri"
        },
        "apiUrl": {
          "type": "string",
          "format": "uri",
          "description": "Exact-card JSON endpoint used lazily by the queued runtime to obtain direct static image URLs."
        },
        "fallbackArtUrl": {
          "type": "string",
          "format": "uri",
          "description": "Sequential last-resort art_crop image endpoint; never used as the initial img src."
        },
        "cardReferences": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional editorial hints for ambiguous card names. The final exhaustive list is discovered from rendered prose by tools/canonicalize_card_links.py and written to data-card-references."
        },
        "cardAliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional shortened display text mapped to exact Oracle names. Use only when prose intentionally abbreviates a card title; automatic exact-name discovery remains authoritative."
        }
      }
    },
    "originalSetCode": {
      "type": "string",
      "pattern": "^[a-z0-9]+$",
      "description": "Original Scryfall set code used by the canonical printing-gallery metadata and fallback runtime."
    },
    "tournamentImpact": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "result",
          "cardCopies",
          "source",
          "wording"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "player": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "cardCopies": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "wording": {
            "type": "string",
            "minLength": 1,
            "description": "Use 'appeared in' or 'was part of'; do not claim the card alone caused a finish."
          },
          "factCheckNote": {
            "type": "string"
          }
        }
      },
      "description": "Significant, sourced tournament appearances for the article card. Omit only when no meaningful result exists."
    },
    "preconstructedDeckArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "catalogueSnapshot",
        "sectionLabel",
        "includeAllMatches",
        "allowNoSideboard",
        "collapsedByDefault",
        "productDecksCollapsedByDefault",
        "emptyState"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "mode": {
          "const": "static-embedded",
          "description": "Decklists are compiled into article HTML at build time. Browser-side catalogue fetching is forbidden."
        },
        "catalogueSnapshot": {
          "type": "string",
          "pattern": "^data/official-mtg-deck-catalogue\\.json$"
        },
        "sectionLabel": {
          "const": "Official Magic the Gathering decks"
        },
        "includeAllMatches": {
          "const": true,
          "description": "Embed every qualifying official deck product containing the article card."
        },
        "allowNoSideboard": {
          "const": true,
          "description": "Products without sideboards remain without sideboards."
        },
        "collapsedByDefault": {
          "const": true
        },
        "productDecksCollapsedByDefault": {
          "const": true
        },
        "emptyState": {
          "const": "No official Magic the Gathering products contained this particular card."
        }
      },
      "description": "Static, offline official-product deck archive generated from the committed catalogue snapshot. Counts and contents are derived from integer card rows."
    },
    "cardImageStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deckRowsLinked",
        "doubleFacedPolicy",
        "leadFaceRules",
        "emptyOfficialDeckCountLabel"
      ],
      "properties": {
        "deckRowsLinked": {
          "const": true,
          "description": "Every rendered quantity row wraps the exact card name in canonical .card-name markup."
        },
        "doubleFacedPolicy": {
          "const": "scryfall-card-faces",
          "description": "Use Scryfall card_faces image_uris so physical front and back faces are distinct."
        },
        "leadFaceRules": {
          "const": "one-panel-per-physical-face",
          "description": "A physical double-faced namesake displays both face images and a separate rules panel for each face."
        },
        "emptyOfficialDeckCountLabel": {
          "const": "0",
          "description": "A zero-result Official Magic the Gathering decks summary displays the numeral 0."
        }
      }
    }
  }
}
